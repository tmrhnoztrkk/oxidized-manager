# Key used to sign session cookies and encrypt stored secrets (remote API keys, git tokens, SSH keys).
# Leave empty to generate one in ./data/.secret_key on first start (keep that file with your backups!).
# Generate one yourself with: openssl rand -base64 48
SECRET_KEY=

MANAGER_PORT=8080
SESSION_HOURS=12

# Behind an HTTPS reverse proxy:
#   SECURE_COOKIES=true           → the session cookie is only sent over HTTPS
#   FORWARDED_ALLOW_IPS=10.0.0.10 → trust X-Forwarded-* headers from this proxy address
SECURE_COOKIES=false
FORWARDED_ALLOW_IPS=127.0.0.1

# How many remote workspaces one installation may manage
MAX_REMOTE_WORKSPACES=10

# Default UI language when the browser does not ask for one (en | tr)
DEFAULT_LANG=en

# Run scheduled pushes to backup destinations (set to false on a standby copy)
BACKUP_SCHEDULER=true

# Tag of the oxidized/oxidized base image
OXIDIZED_VERSION=latest
